<div class="container">

  <h2>Compose query</h2>

  {{#if this.searchError}}
    <div class="alert alert-warning" role="alert">{{this.searchError}}</div>
  {{/if}}

  <form>

    <div class="mb-3">
      <label id="wordsLabel" class="form-label">Middle English word(s)</label>

      <PowerSelect
        @multiple={{true}}
        @searchEnabled={{true}}
        @ariaLabelledBy="wordsLabel"
        aria-describedby="wordsHelp"
        @placeholder="Enter words"
        @selected={{this.words}}
        @selectedItemComponent={{component "selected-item-word"}}
        @onChange={{fn (mut this.words)}}
        @onKeydown={{this.selectOnSpace}}
        @search={{this.completeWord}}
        @searchField="none"
        @renderInPlace={{true}}
        as |entry|
      >
        <strong>{{entry.word}}</strong>
        [{{entry.lemma_tag}}]
        -
        {{format-definitions entry.definition}}
      </PowerSelect>

      <small id="wordsHelp" class="form-text text-muted">Match words as spelled in a given line of text. May enter more than one.</small>
    </div>

    <div class="mb-3">
      <label id="lemmasLabel" class="form-label"><em>Middle English Dictionary</em> headword(s)</label>

      <PowerSelect
        @multiple={{true}}
        @searchEnabled={{true}}
        @ariaLabelledBy="lemmasLabel"
        aria-describedby="lemmasHelp"
        @placeholder="Enter headwords"
        @selected={{this.lemmas}}
        @selectedItemComponent={{component "selected-item-lemma"}}
        @onChange={{fn (mut this.lemmas)}}
        @onKeydown={{this.selectOnSpace}}
        @search={{this.completeLemma}}
        @searchField="none"
        @renderInPlace={{true}}
        as |entry|
      >
        <strong>{{entry.lemma}}</strong>
        [{{entry.word}}]
        [{{entry.lemma_tag}}]
        -
        {{format-definitions entry.definition}}
      </PowerSelect>

      <small id="lemmasHelp" class="form-text text-muted">Finds all words (in all grammatical forms) in the database corresponding to any headword(s) in the MED entered here.</small>
    </div>

    <div class="mb-3">
      <label id="taggedLemmasLabel" class="form-label">Middle English word (by part of speech)</label>

      <PowerSelect
        @multiple={{true}}
        @searchEnabled={{true}}
        @ariaLabelledBy="taggedLemmasLabel"
        aria-describedby="taggedLemmasHelp"
        @placeholder="Enter headwords with part of speech"
        @selected={{this.tagged_lemmas}}
        @selectedItemComponent={{component "selected-item-tagged-lemma"}}
        @onChange={{fn (mut this.tagged_lemmas)}}
        @onKeydown={{this.selectOnSpace}}
        @search={{this.completeTaggedLemma}}
        @searchField="none"
        @renderInPlace={{true}}
        as |entry|
      >
        <strong>{{entry.lemma_tag}}</strong>
        [{{entry.word}}]
        -
        {{entry.definition}}
      </PowerSelect>

      <small id="taggedLemmasHelp" class="form-text text-muted">Finds all words in a particular grammatical form (which can be selected from the grammatically tagged word forms that will auto-fill here) in the database.</small>
    </div>

    <div class="mb-3">
      <label id="restrictLabel" class="form-label">Restrict to location (to author, text, or part of text)</label>

      <PowerSelect
        @multiple={{true}}
        @searchFieldPosition="before-options"
        @ariaLabelledBy="restrictLabel"
        aria-describedby="restrictHelp"
        @options={{this.model.restrictData}}
        @selected={{this.restrict}}
        @onChange={{fn (mut this.restrict)}}
        @searchField="label"
        @placeholder="Select locations"
        @allowClear={{true}}
        @renderInPlace={{true}}
        as |entry|
      >
        {{entry.label}}
      </PowerSelect>

      <small id="restrictHelp" class="form-text text-muted">Only match lines of text in selected locations.</small>
    </div>

    <div class="form-check form-check-inline">
      <Input
        id="allWords"
        class="form-check-input"
        @type="checkbox"
        @checked={{this.requireAllWords}}
      />
      <label class="form-check-label" for="allWords">
        All words and headwords must be present in a line.
      </label>
    </div>

    <div class="form-check form-check-inline mb-2">
      <Input
        id="sort"
        class="form-check-input"
        @type="checkbox"
        @checked={{this.sortLogical}}
      />
      <label class="form-check-label" for="sort">
        Sort results by location instead of relevance.
      </label>
    </div>

    <div id="gcme-search-buttons">
      <button type="button" class="btn btn-secondary" {{on "click" this.clearQuery}}>Clear</button>
      <button type="button" class="btn btn-primary" {{on "click" this.submitSearch}}>Search</button>
    </div>
  </form>

  {{#if this.result}}
    {{#if this.totalHits}}
      <h3 class="text-center">Matches {{this.pageFirstMatchNumber}}-{{this.pageLastMatchNumber}} of total {{this.totalHits}}</h3>

      <div class="container">
        <ModelsTable
          @themeInstance={{this.themeInstance}}
          @data={{this.result.hits.hits}}
          @columns={{this.resultColumns}}
          @showComponentFooter={{false}}
          @showColumnsDropdown={{true}}
          @useFilteringByColumns={{false}}
          @showGlobalFilter={{false}}
          @pageSize={{this.pageSize}}
        />

        <nav id="gcme-search-pages" aria-label="Search result pages">
          <ul class="pagination justify-content-center">
            <li class="page-item {{if this.isFirstPage 'disabled'}}">
              <button
                type="button"
                class="page-link"
                disabled={{this.isFirstPage}}
                {{on "click" this.prevPage}}
              >Previous</button>
            </li>
            <li class="page-item disabled">
              <span class="page-link">Page {{this.pageNumber}} of {{this.pageCount}}</span>
            </li>
            <li class="page-item {{if this.isLastPage 'disabled'}}">
              <button
                type="button"
                class="page-link"
                disabled={{this.isLastPage}}
                {{on "click" this.nextPage}}
              >Next</button>
            </li>
          </ul>
        </nav>
      </div>
    {{else}}
      <h3 class="text-center">No matches</h3>
    {{/if}}
  {{/if}}

</div>
